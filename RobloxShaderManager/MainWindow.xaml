<Window x:Class="RobloxShaderManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobloxShaderManager"
        mc:Ignorable="d"
        Title="Roblox Shader Manager" Height="450" Width="600"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Toggle Button Style -->
        <Style TargetType="Button" x:Key="ToggleButtonStyle">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="ROBLOX SHADER MANAGER" Grid.Row="0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Status Panel -->
        <Border Grid.Row="1" Background="#2D2D30" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Statut du système:" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Carte Graphique NVIDIA: "/>
                    <TextBlock x:Name="TxtNvidiaStatus" Text="Vérification..." Foreground="#FFAA00"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Dossier Ansel (C:\Program Files\NVIDIA Corporation\Ansel): "/>
                    <TextBlock x:Name="TxtAnselStatus" Text="Vérification..." Foreground="#FFAA00"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Dossier Shaders_Pack (Local): "/>
                    <TextBlock x:Name="TxtLocalShadersStatus" Text="Vérification..." Foreground="#FFAA00"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Instructions -->
        <Border Grid.Row="2" Background="#252526" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Instructions:" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                    1. Placez vos fichiers .fx et dossiers de textures dans le dossier "Shaders_Pack" situé à côté de ce programme.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                    2. Cliquez sur le bouton ci-dessous pour ACTIVER les shaders.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5" Foreground="#00FF00" FontWeight="Bold">
                    3. En jeu, appuyez sur Alt+F3 pour ouvrir l'interface NVIDIA Freestyle et sélectionner vos filtres.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5" Foreground="Red" FontWeight="Bold">
                    4. Cliquez sur DÉSACTIVER pour supprimer les shaders du dossier NVIDIA une fois terminé.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Current Status -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="État des shaders: " FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="TxtShaderState" Text="DÉSACTIVÉ" FontSize="18" FontWeight="Bold" Foreground="Red"/>
        </StackPanel>

        <!-- Toggle Button -->
        <Button x:Name="BtnToggleShaders" Grid.Row="4" Style="{StaticResource ToggleButtonStyle}"
                Content="ACTIVER LES SHADERS" Width="300" Height="50" Click="BtnToggleShaders_Click"/>

        <TextBlock x:Name="TxtLog" Grid.Row="5" Margin="0,10,0,0" Foreground="Gray" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

    </Grid>
</Window>